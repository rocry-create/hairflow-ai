generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROFESSIONAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professional Professional?

  @@map("users")
}

model Professional {
  id                String   @id @default(uuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id])
  name              String
  phone             String?
  commissionPercent Float    @default(0)
  isMegaHairSpecialist Boolean @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointments Appointment[]

  @@map("professionals")
}

model Client {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  instagram   String?
  birthday    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  hairRecord   HairRecord?
  conversation Conversation?

  @@map("clients")
}

model Service {
  id              String   @id @default(uuid())
  name            String
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  priceMax           Decimal?  @db.Decimal(10, 2)
  requiresEvaluation Boolean   @default(false)
  isMegaHair         Boolean   @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id             String            @id @default(uuid())
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id])
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  scheduledAt    DateTime
  reminderSentAt DateTime?
  maintenanceReminderSentAt DateTime?
  durationMinutes Int
  status         AppointmentStatus @default(SCHEDULED)
  price          Decimal           @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([professionalId, scheduledAt])
  @@map("appointments")
}

model HairRecord {
  id             String   @id @default(uuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id])
  hairType       String?
  chemicalHistory String?
  lastChemicalAt DateTime?
  productsUsed   String?
  colorFormula   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("hair_records")
}

enum MessageRole {
  CLIENT
  AI
  HUMAN
}

enum ConversationStage {
  NOVO_CONTATO
  PEDIU_ORCAMENTO
  AVALIACAO_MARCADA
  COMPARECEU
  FECHOU_SERVICO
  POS_VENDA
}

model Conversation {
  id        String            @id @default(uuid())
  clientId  String            @unique
  client    Client            @relation(fields: [clientId], references: [id])
  stage     ConversationStage @default(NOVO_CONTATO)
  aiEnabled Boolean           @default(true)
  interestServiceId String?
  autoStageAppointmentId String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum CampaignStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  message     String
  segment     String
  days        Int?
  status      CampaignStatus @default(RUNNING)
  total       Int            @default(0)
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id         String          @id @default(uuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   String
  name       String
  phone      String
  status     RecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model SalonSettings {
  id        String   @id @default("main")
  salonName String   @default("HairFlow")
  openTime  String   @default("09:00")
  closeTime String   @default("19:00")
  weekdays  String   @default("1,2,3,4,5,6")
  updatedAt DateTime @updatedAt

  @@map("salon_settings")
}

model QuickReply {
  id        String   @id @default(uuid())
  shortcut  String   @unique
  title     String
  category  String   @default("Atendimento")
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_replies")
}

model GroupEvent {
  id        String   @id @default(uuid())
  event     String?
  payload   Json
  createdAt DateTime @default(now())

  @@map("group_events")
}
